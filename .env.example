# Firebase Environment Variables
# Copy this file to .env and fill in your Firebase project values.
# NEVER commit your actual .env file to version control.

# These are PUBLIC client-side config values that identify your Firebase project.
# They are NOT secrets — security is enforced by Firestore Security Rules and
# Firebase Authentication, NOT by keeping these values hidden.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
